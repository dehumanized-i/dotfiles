{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "type": "os",
            "key": "OS -->",
            "keyColor": "yellow"
        },
        {
            "type": "kernel",
            "key": "Kernel -->",
            "keyColor": "yellow"
        },
        {
            "type": "command",
            "key": "Command -->",
            "keyColor": "yellow",
            "text": "LC_ALL=C date -d \"@$(stat -c %W /)\" \"+%d-%m-%Y %H:%M\" 2>/dev/null || echo N/A"
        },
        {
            "type": "uptime",
            "key": "Uptime -->",
            "keyColor": "yellow"
        },
        {
            "type": "packages",
            "key": "Packages -->",
            "keyColor": "yellow"
        },
        {
            "type": "shell",
            "key": "Shell -->",
            "keyColor": "yellow"
        },
        {
            "type": "locale",
            "key": "Locale -->",
            "keyColor": "yellow"
        },
        "break",
        {
            "type": "wm",
            "key": "WM -->",
            "keyColor": "blue"
        },
        {
            "type": "de",
            "key": "DE -->",
            "keyColor": "blue"
        },
        {
            "type": "lm",
            "key": "LM -->",
            "keyColor": "blue"
        },
        {
            "type": "wmtheme",
            "key": "WM Theme -->",
            "keyColor": "blue"
        },
        {
            "type": "icons",
            "key": "Icons -->",
            "keyColor": "blue"
        },
        {
            "type": "cursor",
            "key": "Cursor -->",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "Terminal -->",
            "keyColor": "blue"
        },
        {
            "type": "terminalfont",
            "key": "Terminal Font -->",
            "keyColor": "blue"
        },
        "break",
        {
            "type": "host",
            "key": "Host -->",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": "CPU -->",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "key": "GPU -->",
            "keyColor": "green"
        },
        {
            "type": "display",
            "key": "Display ({name}) -->",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "Memory -->",
            "keyColor": "green"
        },
        {
            "type": "disk",
            "key": "Disk ({mountpoint}) -->",
            "keyColor": "green"
        },
        {
            "type": "swap",
            "key": "Swap -->",
            "keyColor": "green"
        },
        {
            "type": "battery",
            "key": "Battery ({name}) -->",
            "keyColor": "green"
        },
        {
            "type": "localip",
            "key": "Local IP ({ifname}) -->",
            "keyColor": "green"
        },
  	"break",
	{
	   "type": "colors",
	}
    ]
}
